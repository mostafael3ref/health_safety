    },
    {
      "fieldname": "site",
      "label": "Site",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "supervision",
      "label": "Supervision",
