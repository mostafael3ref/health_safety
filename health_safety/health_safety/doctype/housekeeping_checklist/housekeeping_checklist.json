      "reqd": 1
    },
    {
      "fieldname": "req_field_free_flammables",
      "label": "Free of Flammable Materials",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "description": "Is the field free of herbs, wood and flammable materials?",
      "reqd": 1
    },
    {
      "fieldname": "req_random_storage_obstacle_emergencies",
      "label": "Random Storage Risk",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "description": "Is storing materials randomly might be an obstacle during emergencies?",
      "reqd": 1
    },
    {
      "fieldname": "req_random_papers_offices",
      "label": "Random Papers in Offices",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "description": "Are there randomly stacked papers in offices?",
      "reqd": 1
    },
    {
      "fieldname": "req_storage_under_stairs",
      "label": "Storage Under Stairs",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "description": "Is there a storing under the stairs?",
      "reqd": 1
