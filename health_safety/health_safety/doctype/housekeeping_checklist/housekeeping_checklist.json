      "fieldname": "section_requirements",
      "label": "Requirements",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "req_floors_clean_no_slip",
      "label": "Clean Floors",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "description": "Are the floors clean and do not pose a risk of slipping?",
      "reqd": 1
    },
    {
      "fieldname": "req_floors_safe_no_trip",
      "label": "Safe Floors",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "description": "Are the floors safe and free from the risk of tripping?",
      "reqd": 1
    },
    {
      "fieldname": "req_site_clean_no_waste",
