      "options": "YES\nNO\nN/A",
      "description": "Is the cleanliness of the site good and there is no waste?",
      "reqd": 1
    },
    {
      "fieldname": "req_waste_containers_available",
      "label": "Waste Containers Available",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "description": "Are containers for waste materials disposal available?",
      "reqd": 1
    },
    {
      "fieldname": "req_waste_containers_emptied_daily",
      "label": "Waste Emptied Daily",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "description": "Are waste containers emptied daily?",
      "reqd": 1
    },
    {
      "fieldname": "req_accumulation_dirt_dust",
