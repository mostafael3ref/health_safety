      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "site",
      "label": "Site",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "supervision",
      "label": "Supervision",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "operator",
      "label": "Operator",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "address",
