    {
      "fieldname": "mobile_cranes_section",
      "label": "Mobile Cranes",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "mc_solid_floor",
      "label": "Does the lifting equipment stand on a solid and consistent floor ?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_third_party_serviced",
      "label": "Is the lift equipment fully serviced by a third party?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_hooks_per_manufacturer",
      "label": "Are all hooks used in accordance with the manufacturer's recommendations?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_max_load_board",
      "label": "Is there a board showing the maximum load capacity of the lifting equipment?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_area_secured",
      "label": "Is the work area secured and warning labels set before work?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_arms_intact",
      "label": "Are operating arms intact and clearly marked?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_cables_safe",
      "label": "Is the safety of cable wires ensured and it has no defects?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_operator_qualified",
      "label": "Is the lift equipment operator qualified and aware of safety instructions?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_controls_intact",
      "label": "Are the control and guidance systems intact and clearly marked?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_cab_barrier",
      "label": "Is there protective barrier on driver's cab?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_warning_lights",
      "label": "Does the mobile lifting equipment have warning lights?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_hook_unharmed",
      "label": "Is the lifting hook unharmed?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_boom_angle_indicator",
      "label": "Is there a device that shows the Boom Angle Indicator and this device is in a clear place for the winch operator?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_boom_length_device",
      "label": "Is there a device that shows the length of boom and the distance between it and the middle of the wheels of the crane (Load Radius)?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_weather_stable",
      "label": "Is weather and wind stable and does not pose risk to the work of lifting equipment?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_ppe_committed",
      "label": "Are employees committed on wearing PPE?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "mc_inspection_record",
      "label": "Is there a record to examine and test the lifting equipment?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },

    {
      "fieldname": "personal_basket_section",
      "label": "Personal Basket",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "pb_checked_external",
      "label": "Is the basket checked by an external specialist?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "pb_plate_showing_weight",
      "label": "Is there a plate on the basket showing the weight of the basket and its maximum load?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "pb_handrail_with_protection",
      "label": "Is there a handrail with upper, middle and foot protection?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "pb_bottom_barrier",
      "label": "Is there a bottom barrier to prevent the fall of equipment and materials from the basket?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "pb_lockable_door",
      "label": "Availability of a door for the basket so that it is locked and does not open outside in the case of lifting personnel and is equipped with a device to tighten it and prevents the opening of the door during uplifting the basket?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "pb_roof_protection",
      "label": "The necessity for the upper part of the basket (roof) to protect workers from the dangers of falling materials, with the height of this ceiling being appropriate to the length of individuals?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "pb_tag_line",
      "label": "Is there a special rope (Tag Line) to be used to move the basket while lifting it?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "pb_workers_helmet",
      "label": "The necessity of the workers in the basket to use the helmet?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },
    {
      "fieldname": "pb_fall_protection",
      "label": "Are workers insured from falling hazards and provided with safety belts and ropes?",
      "fieldtype": "Select",
      "options": "YES\nNO\nN/A",
      "reqd": 1
    },

    {
      "fieldname": "inspector_section",
      "label": "Inspector",
      "fieldtype": "Section Break"
    },
