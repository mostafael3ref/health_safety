      "fieldtype": "Data"
    },
    {
      "fieldname": "site_responsible_job_title",
      "label": "Job Title (Site Responsible)",
      "fieldtype": "Data"
    },
    {
      "fieldname": "site_responsible_digital_signature",
      "label": "Digital Signature (Site Responsible)",
      "fieldtype": "Signature"
    },
    {
      "fieldname": "site_responsible_image_signature",
      "label": "Image Signature (Site Responsible)",
      "fieldtype": "Attach Image"
    }
  ]
