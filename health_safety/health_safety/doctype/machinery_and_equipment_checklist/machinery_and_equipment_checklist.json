    },

    {
      "fieldname": "section_site_responsible",
      "label": "Site Responsible",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "site_resp_name",
      "label": "Name Site Responsible",
      "fieldtype": "Data"
    },
    {
      "fieldname": "site_resp_job_title",
      "label": "Job Title (Site)",
      "fieldtype": "Data"
    },
    {
      "fieldname": "site_resp_digital_signature",
      "label": "Digital Signature (Site)",
      "fieldtype": "Signature"
    },
    {
      "fieldname": "site_resp_image_signature",
      "label": "Image Signature (Site)",
      "fieldtype": "Attach Image"
    }
  ]
}
